# uploads.env.sample — every environment variable the uploader reads in
# production, with no values filled in.
#
# Install as:
#     install -o root -g www-data -m 0640 /dev/null /etc/uploads.env
#     <edit in the values below, real file only, never this sample>
#
# HOST, PORT, CLOUDGENE_BASE_URL, UPLOADER_SAS_ISSUER, AZURE_STORAGE_ACCOUNT,
# AZURE_STORAGE_CONTAINER and UPLOADER_DB_PATH are already set directly in
# uploads.service and are NOT repeated here. This file is loaded by
# EnvironmentFile=, which is listed after those Environment= lines in the
# unit and therefore overrides them — see the comment on that line in
# uploads.service. Only add a key below if you deliberately mean to
# override the unit's default; an empty/absent key here changes nothing.

# --- Required. The service refuses to start without these three. ---
# Source: `az ad sp create-for-rbac --create-cert` output, recorded in
# uploader/azure.md. Never commit real values — this file lives outside the
# repo (/etc/uploads.env) precisely because a unit file is world-readable
# and this is not.

# Entra tenant ID for the uploader's own app registration.
AZURE_TENANT_ID=

# Entra application (client) ID for the same app registration.
AZURE_CLIENT_ID=

# Path to the PEM holding the service principal's certificate and private
# key. Must be owned/readable by the service user and NOT world-readable —
# config._certificate_path refuses to start otherwise. Installed per
# deploy/README.md's certificate step.
AZURE_CLIENT_CERTIFICATE_PATH=/etc/cloudgene-uploader/azure-cert.pem

# --- Optional. Uncomment only to override the built-in default. ---
# Defaults and full descriptions: uploader/api/README.md's environment
# variable table.

# UPLOADER_AUTH_PROVIDER=cloudgene
# UPLOADER_MAX_UPLOAD_BYTES=536870912000
# UPLOADER_SAS_TTL_SECONDS=86400
# UPLOADER_RATE_LIMIT_MAX=200
# UPLOADER_RATE_LIMIT_WINDOW_SECONDS=3600
# UPLOADER_ALLOWED_EXTENSIONS=
# UPLOADER_ALLOWED_CONTENT_TYPES=
# UPLOADER_MAX_LIST_RESULTS=1000
# UPLOADER_MAX_RENEWALS=10
# UPLOADER_LOG_LEVEL=INFO

# --- Never set these here in production. ---
# UPLOADER_SAS_ISSUER=local or =fake, and UPLOADER_AUTH_PROVIDER=fake, are
# local-development-only values. Setting either here silently overrides the
# unit's production default without changing anything visible until the
# next journal check — see deploy/README.md §9's post-install verification,
# which exists specifically to catch this.
